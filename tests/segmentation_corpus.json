{
  "schemaVersion": 1,
  "source": {
    "artifact": "decompiled reference TTS client",
    "observations": [
      "The default sentence iterator uses Locale.US.",
      "Language and country select a cached locale-specific BreakIterator sentence instance.",
      "Sentence text is trimmed before it is emitted.",
      "A sentence longer than 200 UTF-16 code units is diagnosed as overly long."
    ],
    "scope": "Behavioral cases inspired by observed reference-client behavior; expected results are for this add-on's Unicode-aware, low-latency segmenter."
  },
  "cases": [
    {
      "id": "en-us-quoted-question-and-title",
      "category": "locale-punctuation",
      "locale": "en-US",
      "operation": "sentenceUnits",
      "text": "Doctor Rivera asked, “Ready?” Then the test began.",
      "expected": [
        "Doctor Rivera asked, “Ready?”",
        "Then the test began."
      ]
    },
    {
      "id": "vi-vn-common-abbreviations",
      "category": "abbreviation",
      "locale": "vi-VN",
      "operation": "sentenceUnits",
      "text": "TS. Nguyễn An làm việc tại TP. Hồ Chí Minh. Hôm nay anh ấy thử giọng.",
      "expected": [
        "TS.",
        "Nguyễn An làm việc tại TP.",
        "Hồ Chí Minh.",
        "Hôm nay anh ấy thử giọng."
      ]
    },
    {
      "id": "de-de-common-abbreviations",
      "category": "abbreviation",
      "locale": "de-DE",
      "operation": "sentenceUnits",
      "text": "Dr. Weber wartet bzw. prüft weiter. Danach startet die Stimme.",
      "expected": [
        "Dr.",
        "Weber wartet bzw.",
        "prüft weiter.",
        "Danach startet die Stimme."
      ]
    },
    {
